doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    meta(name="description" content="MUBS Job Portal — Find academic, administrative and support staff vacancies at Makerere University Business School")
    title #{title} | MUBS Jobs

    //- Favicon
    link(rel="icon" type="image/png" href="/images/logo.png")
    link(rel="apple-touch-icon" href="/images/logo.png")

    link(rel="preconnect" href="https://fonts.googleapis.com")
    link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
    link(href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet")
    link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css")
    link(rel="stylesheet" href="/css/style.css")
    block head
  body
    include partials/header.pug

    if success && success.length
      .alert.alert-success
        i.fas.fa-check-circle
        span= success
        button.alert-close(type="button") ×
    if error && error.length
      .alert.alert-error
        i.fas.fa-exclamation-circle
        span= error
        button.alert-close(type="button") ×

    main
      block content

    include partials/footer.pug
    include partials/modal.pug

    //- Core Scripts
    script(src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js")
    script(src="/js/main.js" defer)
    script(src="/js/modal.js" defer)
    
    //- Page-specific scripts
    block scripts

    //- Tawk.to Chat Widget (System-wide)
    script(type="text/javascript").
      var Tawk_API=Tawk_API||{}, Tawk_LoadStart=new Date();
      (function(){
      var s1=document.createElement("script"),s0=document.getElementsByTagName("script")[0];
      s1.async=true;
      s1.src='https://embed.tawk.to/6ae052e3e9f88b347479d4ed/1k5u47j3p';
      s1.charset='UTF-8';
      s1.setAttribute('crossorigin','*');
      s0.parentNode.insertBefore(s1,s0);
      })();