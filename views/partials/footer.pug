footer.site-footer
  .container
    .footer-grid
      .footer-brand
        a.logo(href="/")
          img.logo-img(src="/images/logo.png" alt="MUBS Job Portal")
          .logo-text
            strong MUBS
            span Job Portal
        p Connecting MUBS students, alumni, and professionals with academic and administrative opportunities at Makerere University Business School.
        .social-links
          a(href="#" aria-label="Facebook"): i.fab.fa-facebook
          a(href="#" aria-label="Twitter"): i.fab.fa-twitter
          a(href="#" aria-label="LinkedIn"): i.fab.fa-linkedin
          a(href="#" aria-label="Instagram"): i.fab.fa-instagram

      .footer-col
        h4 For Applicants
        ul
          li: a(href="/jobs") Browse Jobs
          li: a(href="/jobs?type=Part-time") Part-time Roles
          li: a(href="/jobs?terms=Contract") Contract Positions
          li: a(href="/auth/register") Create Account

      .footer-col
        h4 For Staff
        ul
          li: a(href="/jobs/new") Post a Vacancy
          li: a(href="https://www.mubs.ac.ug" target="_blank" rel="noopener") MUBS Website
          li: a(href="#") User Guide
          li: a(href="#") Contact HR

      .footer-col
        h4 Institution
        ul
          li: a(href="https://www.mubs.ac.ug" target="_blank" rel="noopener") MUBS Website
          li: a(href="#") About the Portal
          li: a(href="#") Privacy Policy
          li: a(href="#") Terms of Service

    .footer-bottom
      p © #{new Date().getFullYear()} Makerere University Business School. All rights reserved.
      p Built with #[i.fas.fa-heart(style="color: #ef4444")] by the #[a(href="https://mubs.ac.ug" target="_blank" rel="noopener") eLearning Centre]