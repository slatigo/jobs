header.site-header
  .container.header-inner
    a.logo(href="/")
      .logo-icon M
      .logo-text
        strong MUBS
        span Job Portal

    button.nav-toggle(type="button" aria-label="Toggle navigation")
      span
      span
      span

    nav.main-nav
      a.nav-link(href="/" class=currentPath === '/' ? 'active' : '') Home
      a.nav-link(href="/jobs" class=currentPath.startsWith('/jobs') ? 'active' : '') Jobs
      a.nav-link(href="/departments" class=currentPath.startsWith('/departments') ? 'active' : '') Departments

      if user && (user.role === 'employer' || user.role === 'admin')
        a.nav-link(href="/jobs/new" class=currentPath === '/jobs/new' ? 'active' : '') Post a Job
      if user && user.role === 'admin'
        a.nav-link(href="/admin" class=currentPath.startsWith('/admin') ? 'active' : '') Admin

      .nav-actions
        if user
          .user-menu
            button.user-btn(type="button")
              .avatar= user.name.charAt(0).toUpperCase()
              span= user.name.split(' ')[0]
              i.fas.fa-chevron-down
            .dropdown
              a(href="/auth/logout")
                i.fas.fa-sign-out-alt
                | Logout
        else
          a.btn.btn-ghost(href="/auth/login") Login
          a.btn.btn-primary(href="/auth/register") Sign Up