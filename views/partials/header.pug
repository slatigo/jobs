header.site-header
  .container.header-inner
    a.logo(href="/")
      img.logo-img(src="/images/logo.png" alt="MUBS Job Portal")
      .logo-text
        strong MUBS
        span Job Portal

    button.nav-toggle(type="button" aria-label="Toggle navigation")
      span
      span
      span

    nav.main-nav
      - const path = currentPath || ''
      a.nav-link(href="/" class=path === '/' ? 'active' : '') Home
      a.nav-link(href="/jobs" class=(path.startsWith('/jobs') && path !== '/jobs/new') ? 'active' : '') Jobs

      if user && user.role === 'admin'
        a.nav-link(href="/departments" class=path.startsWith('/departments') ? 'active' : '') Departments

      if user && (user.role === 'employer' || user.role === 'admin')
        a.nav-link(href="/jobs/new" class=path === '/jobs/new' ? 'active' : '') Post a Job

      if user && user.role === 'admin'
        a.nav-link(href="/admin" class=path.startsWith('/admin') ? 'active' : '') Admin

      .nav-actions
        if user
          .user-menu
            button.user-btn(type="button" aria-haspopup="true")
              .avatar= (user.name || 'U').charAt(0).toUpperCase()
              span= (user.name || 'User').split(' ')[0]
              i.fas.fa-chevron-down
            .dropdown
              a(href="/auth/change-password")
                i.fas.fa-key
                | Change Password
              a(href="/auth/logout")
                i.fas.fa-sign-out-alt
                | Logout
        else
          a.btn.btn-ghost(href="/auth/login") Login
          a.btn.btn-primary(href="/auth/register") Sign Up