extends ../layout

block content
  section.job-detail
    .container
      .job-detail-layout
        .job-main
          .job-header-card
            .job-header-top
              - const categoryIcons = { ADM: 'fa-briefcase', ACA: 'fa-graduation-cap', SUP: 'fa-hands-helping', TEC: 'fa-laptop-code', INT: 'fa-building', GEN: 'fa-university' }
              - const iconClass = categoryIcons[job.refCategory] || 'fa-university'
              .company-logo-lg(class=`logo-cat-${job.refCategory || 'GEN'}`)
                i.fas(class=iconClass)
              .job-header-info
                h1= job.title
                p.company-name
                  i.fas.fa-university
                  = job.department ? job.department.name : 'MUBS'
                if job.jobRef
                  p.ref-line Ref: #{job.jobRef}
                .job-badges
                  span.badge.badge-primary= job.type
                  span.badge.badge-secondary= job.contractTerms
                  if job.grade
                    span.badge.badge-secondary Grade #{job.grade}
                  if job.status === 'closed'
                    span.badge.badge-closed
                      i.fas.fa-lock
                      | Closed
                  if job.featured
                    span.badge.badge-featured
                      i.fas.fa-star
                      | Featured

            .job-info-grid
              .info-item
                i.fas.fa-map-marker-alt
                div
                  span Duty Station
                  strong= job.location
              .info-item
                i.fas.fa-users
                div
                  span Vacancies
                  strong= job.vacancies
              .info-item
                i.fas.fa-calendar-times
                div
                  span Deadline
                  strong= appTime.format(job.deadline)
              .info-item
                i.fas.fa-eye
                div
                  span Views
                  strong= job.views

          .job-section
            h2
              i.fas.fa-file-alt
              | Position Details
            .job-text!= job.description

        .job-sidebar
          //- ============================================================
          //- MANAGE (poster or admin only)
          //- ============================================================
          if canManage
            .sidebar-card.manage-card
              h3
                i.fas.fa-cog
                |  Manage
              .manage-actions
                a.btn.btn-primary.btn-block(href=`/jobs/${job.id}/applications`)
                  i.fas.fa-users
                  if applicationCount > 0
                    |  View Applications (#{applicationCount})
                  else
                    |  Applications (0)

                a.btn.btn-outline.btn-block(href=`/jobs/${job.id}/edit`)
                  i.fas.fa-edit
                  |  Edit Job
                a.btn.btn-outline.btn-block(href=`/jobs/${job.id}/stages`)
                  i.fas.fa-layer-group
                  |  Manage Stages

                if job.status === 'active'
                  form(action=`/jobs/${job.id}/close` method="POST" data-confirm="Close this job? Applicants will no longer be able to apply." data-confirm-title="Close Job" data-confirm-label="Close Job" data-confirm-tone="warning")
                    button.btn.btn-outline.btn-block(type="submit")
                      i.fas.fa-lock
                      |  Close Job
                else
                  form(action=`/jobs/${job.id}/reopen` method="POST" data-confirm="Reopen this job? Applicants will be able to apply again." data-confirm-title="Reopen Job" data-confirm-label="Reopen Job" data-confirm-tone="success")
                    button.btn.btn-success.btn-block(type="submit")
                      i.fas.fa-unlock
                      |  Reopen Job

                form(action=`/jobs/${job.id}/delete` method="POST" data-confirm="Permanently delete this job and all its applications? This cannot be undone." data-confirm-title="Delete Job" data-confirm-label="Delete Permanently" data-confirm-tone="danger")
                  button.btn.btn-danger.btn-block(type="submit")
                    i.fas.fa-trash
                    |  Delete Job

          //- ============================================================
          //- APPLY (everyone else)
          //- ============================================================
          if !canManage
            .sidebar-card.apply-card
              h3 Apply for this Position

              if alreadyApplied
                .applied-notice
                  i.fas.fa-check-circle
                  p You have already applied to this vacancy.

              else if user
                form.apply-form(action=`/jobs/${job.id}/apply` method="POST" enctype="multipart/form-data" novalidate)
                  .form-group
                    label Full Name
                    input(type="text" name="fullName" value=user.name required)

                  .form-group
                    label Email
                    input(type="email" name="email" value=user.email required)

                  .form-group
                    label Phone
                    input(
                      type="tel"
                      name="phone"
                      required
                      value=user.phone || ''
                      autocomplete="tel"
                    )

                  .form-group
                    label Attachment *
                    small.text-muted Required document — PDF, DOC or DOCX. Max 10 MB.
                    input#attachmentInput(
                      type="file"
                      name="attachment"
                      accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document"
                      required
                    )
                    .file-preview#filePreview

                  button.btn.btn-primary.btn-block.apply-submit(type="submit")
                    i.fas.fa-paper-plane
                    |  Submit Application

              else
                .apply-cta
                  p Login or create an account to apply for this position.
                  a.btn.btn-primary.btn-block(href="/auth/login") Login
                  a.btn.btn-outline.btn-block(href="/auth/register") Register

          //- ============================================================
          //- CONTACT
          //- ============================================================
          .sidebar-card
            h3 Contact Information
            .contact-item
              i.fas.fa-envelope
              div
                span Email
                a(href=`mailto:${job.contactEmail}`)= job.contactEmail
            if job.contactPhone
              .contact-item
                i.fas.fa-phone
                div
                  span Phone
                  a(href=`tel:${job.contactPhone}`)= job.contactPhone

          //- ============================================================
          //- SHARE
          //- ============================================================
          .sidebar-card.share-card
            h3
              i.fas.fa-share-alt
              |  Share this Vacancy

            if job.shortCode
              .share-link
                input.share-link-input(
                  type="text"
                  readonly
                  value=job.getShareUrl()
                  onclick="this.select()"
                  aria-label="Share link"
                )
                button.btn.btn-sm.btn-primary.share-copy-btn(
                  type="button"
                  onclick="copyShareLink(this)"
                  title="Copy link"
                )
                  i.fas.fa-copy
                  span Copy
            else
              .share-link
                input.share-link-input(
                  type="text"
                  readonly
                  value=(APP_URL || '') + '/jobs/' + job.id
                  onclick="this.select()"
                  aria-label="Job link"
                )
                button.btn.btn-sm.btn-primary.share-copy-btn(
                  type="button"
                  onclick="copyShareLink(this)"
                  title="Copy link"
                )
                  i.fas.fa-copy
                  span Copy

block scripts
  script.
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.querySelector('.apply-form');
      if (!form) return;

      const submitBtn    = form.querySelector('.apply-submit');
      const originalHTML = submitBtn ? submitBtn.innerHTML : '';
      const fileInput    = document.getElementById('attachmentInput');
      const filePreview  = document.getElementById('filePreview');

      /* --------------------------------------------------------------
         File preview — filename + size on pick
         -------------------------------------------------------------- */
      if (fileInput && filePreview) {
        fileInput.addEventListener('change', () => {
          const f = fileInput.files && fileInput.files[0];
          if (!f) {
            filePreview.classList.remove('visible', 'warn');
            filePreview.textContent = '';
            return;
          }
          const sizeMB = f.size / (1024 * 1024);
          const sizeText = sizeMB < 1
            ? Math.round(f.size / 1024) + ' KB'
            : sizeMB.toFixed(1) + ' MB';

          filePreview.classList.add('visible');
          filePreview.classList.toggle('warn', sizeMB > 10);
          filePreview.innerHTML =
            '<i class="fas ' + (sizeMB > 10 ? 'fa-exclamation-triangle' : 'fa-file-alt') + '"></i>' +
            '<span class="file-name">' + f.name + '</span>' +
            '<span class="file-size">(' + sizeText + ')</span>' +
            (sizeMB > 10 ? '<span class="file-size"> — exceeds 10 MB</span>' : '');
        });
      }

      /* --------------------------------------------------------------
         Restore UI on failure
         -------------------------------------------------------------- */
      function restore() {
        if (!submitBtn) return;
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalHTML;
        form.querySelectorAll('input, select, textarea').forEach((el) => {
          el.readOnly = false;
        });
      }

      /* --------------------------------------------------------------
         Submit — client validation → AJAX → SweetAlert
         -------------------------------------------------------------- */
      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        const fullName = form.querySelector('[name="fullName"]').value.trim();
        const email    = form.querySelector('[name="email"]').value.trim();
        const phone    = form.querySelector('[name="phone"]').value.trim();
        const file     = fileInput && fileInput.files ? fileInput.files[0] : null;

        const errors = [];
        if (fullName.length < 3) errors.push('Please enter your full name.');
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) errors.push('Please enter a valid email address.');
        if (!phone) errors.push('Phone number is required.');
        if (!file) errors.push('Please attach your CV or resume.');
        else if (file.size > 10 * 1024 * 1024) errors.push('Attachment must be 10 MB or smaller.');

        if (errors.length) {
          Swal.fire({
            icon: 'warning',
            title: 'Please check the form',
            html: '<ul style="text-align:left;margin:0;padding-left:18px;">'
              + errors.map((m) => '<li>' + m + '</li>').join('')
              + '</ul>',
            confirmButtonText: 'OK'
          });
          return;
        }

        /* Lock UI */
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Submitting…';
        form.querySelectorAll('input, select, textarea').forEach((el) => {
          el.readOnly = true;
        });

        try {
          const fd = new FormData(form);
          const res = await fetch(form.action, {
            method: 'POST',
            body: fd,
            headers: { 'Accept': 'application/json' },
            credentials: 'same-origin'
          });

          const data = await res.json().catch(() => ({
            ok: false,
            message: 'Server returned an unexpected response.'
          }));

          if (res.ok && data.ok) {
            await Swal.fire({
              icon: 'success',
              title: 'Application Submitted',
              text: data.message || 'Your application has been submitted.',
              confirmButtonText: 'Continue',
              allowOutsideClick: false
            });
            window.location.href = data.redirect || window.location.pathname;
            return;
          }

          Swal.fire({
            icon: 'error',
            title: 'Could not submit',
            text: data.message || 'Please try again.'
          });
          restore();
        } catch (err) {
          console.error('[APPLY AJAX]', err);
          Swal.fire({
            icon: 'error',
            title: 'Network error',
            text: 'Could not reach the server. Please check your connection and try again.'
          });
          restore();
        }
      });

      /* Restore state if user navigates back */
      window.addEventListener('pageshow', restore);
    });