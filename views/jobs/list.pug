extends ../layout

block content
  section.page-header
    .container
      h1 Browse Vacancies
      p #{total} opportunit#{total === 1 ? 'y' : 'ies'} available

  section.jobs-list
    .container
      .jobs-layout
        aside.filters
          form.filter-form(action="/jobs" method="GET")
            //- Title search — visible to everyone
            .filter-group
              label
                i.fas.fa-search
                | Search
              input(
                type="text"
                name="search"
                value=filters.search
                placeholder="Search by job title..."
              )

            //- Department filter — admin only
            if isAdmin
              .filter-group
                label
                  i.fas.fa-university
                  | Department / Faculty
                select(name="department")
                  option(value="All") All Departments
                  each d in departments
                    option(value=d.slug selected=filters.department === d.slug)= d.name

            .filter-group
              label
                i.fas.fa-clock
                | Job Type
              select(name="type")
                option(value="All") All Types
                each t in JOB_TYPES
                  option(value=t selected=filters.type === t)= t

            .filter-group
              label
                i.fas.fa-file-contract
                | Contract Terms
              select(name="terms")
                option(value="All") All Terms
                each c in CONTRACT_TERMS
                  option(value=c selected=filters.terms === c)= c

            .filter-group
              label
                i.fas.fa-map-marker-alt
                | Location
              input(type="text" name="location" value=filters.location placeholder="e.g. Kampala")

            //- Status filter — admin only
            if isAdmin
              .filter-group
                label
                  i.fas.fa-archive
                  | Status
                select(name="status")
                  option(value="active" selected=filters.status === 'active') Active
                  option(value="closed" selected=filters.status === 'closed') Closed
                  option(value="all"    selected=filters.status === 'all')    All

            button.btn.btn-primary.btn-block(type="submit")
              i.fas.fa-filter
              | Apply Filters
            a.btn.btn-ghost.btn-block(href="/jobs") Clear Filters

        .jobs-content
          if jobs.length
            .jobs-grid.jobs-grid-2
              each job in jobs
                include ../partials/job-card.pug

            if totalPages > 1
              nav.pagination
                if currentPage > 1
                  a.page-link(href=`/jobs?page=${currentPage - 1}&search=${filters.search}&department=${filters.department}&type=${filters.type}&terms=${filters.terms}&location=${filters.location}&status=${filters.status}`)
                    i.fas.fa-chevron-left
                each p in Array.from({ length: totalPages }, (_, i) => i + 1)
                  if p === currentPage
                    span.page-link.active= p
                  else
                    a.page-link(href=`/jobs?page=${p}&search=${filters.search}&department=${filters.department}&type=${filters.type}&terms=${filters.terms}&location=${filters.location}&status=${filters.status}`)= p
                if currentPage < totalPages
                  a.page-link(href=`/jobs?page=${currentPage + 1}&search=${filters.search}&department=${filters.department}&type=${filters.type}&terms=${filters.terms}&location=${filters.location}&status=${filters.status}`)
                    i.fas.fa-chevron-right
          else
            .empty-state
              i.fas.fa-search-minus
              h3 No vacancies found
              p Try adjusting your filters or search terms.
              a.btn.btn-primary(href="/jobs") View All Jobs