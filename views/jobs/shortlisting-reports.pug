extends ../layout

block content
  - const resultLabels = { met: 'Met', partial: 'Partial', not_met: 'Not met', unclear: 'Unclear', not_applicable: 'Not applicable' }
  - const tabs = [{ key: 'list', label: 'All applicants', count: counts.all }, { key: 'pass', label: 'Passed', count: counts.pass }, { key: 'review', label: 'Review', count: counts.review }, { key: 'fail', label: 'Did not meet', count: counts.fail }, { key: 'all', label: 'All with judgement', count: counts.all }]

  section.page-header
    .container
      p.breadcrumb
        a(href="/jobs") Jobs
        span.sep /
        a(href=`/jobs/${job.id}`)= job.title
        span.sep /
        a(href=`/jobs/${job.id}/applications`) Applications
        span.sep /
        span Shortlisting report
      h1 Shortlisting report
      p #{job.title}#{job.department ? ' · ' + job.department.name : ''}#{job.jobRef ? ' · Ref: ' + job.jobRef : ''}

  section.applications-page
    .container
      nav.status-tabs
        each tab in tabs
          a.status-tab(
            href=`/jobs/${job.id}/applications/reports?view=${tab.key}`
            class=(view === tab.key ? 'active' : '')
          )
            span= tab.label
            span.tab-count= tab.count

      .report-toolbar
        div
          h2= viewTitle
          p
            if view === 'list'
              | #{people.length} applicant#{people.length === 1 ? '' : 's'}. Name, contact and the date applied.
            else if view === 'pass'
              | #{people.length} applicant#{people.length === 1 ? '' : 's'} who met the mandatory requirements.
            else if view === 'review'
              | #{people.length} applicant#{people.length === 1 ? '' : 's'} whose pack still needs a person to check it.
            else if view === 'fail'
              | #{people.length} applicant#{people.length === 1 ? '' : 's'} who did not meet a mandatory requirement.
            else
              | #{people.length} applicant#{people.length === 1 ? '' : 's'}, with the judgement and the reason.
            if counts.unscreened && view === 'all'
              |  #{counts.unscreened} not yet screened.
        .report-exports
          if view === 'list'
            a.btn.btn-ghost(href=`/jobs/${job.id}/applications/export.pdf`)
              i.fas.fa-file-pdf
              |  PDF
            a.btn.btn-ghost(href=`/jobs/${job.id}/applications/export.csv`)
              i.fas.fa-file-csv
              |  CSV
          else
            a.btn.btn-ghost(href=`/jobs/${job.id}/applications/reports/${view}.xlsx`)
              i.fas.fa-file-excel
              |  Excel
            a.btn.btn-ghost(href=`/jobs/${job.id}/applications/reports/${view}.pdf`)
              i.fas.fa-file-pdf
              |  PDF

      if !people.length
        .report-empty No applicants in this list.
      else if view === 'list'
        .app-table-wrap
          table.app-table
            thead
              tr
                th No.
                th Applicant
                th Email
                th.th-hide-sm Phone
                th.th-hide-md Applied
            tbody
              each person, index in people
                tr
                  td= index + 1
                  td
                    strong= person.fullName
                  td= person.email
                  td.th-hide-sm= person.phone || '—'
                  td.th-hide-md= person.applied || '—'
      else
        .app-table-wrap
          table.app-table.report-table
            thead
              tr
                th No.
                th Applicant
                th.th-hide-md Score
                th Judgement
                th Reason
            tbody
              each person, index in people
                tr
                  td= index + 1
                  td.td-applicant
                    strong= person.fullName
                    .report-contact
                      span= person.email
                      if person.phone
                        span= person.phone
                      if person.applied
                        span Applied #{person.applied}
                  td.th-hide-md= person.scoreLabel || '—'
                  td
                    .report-judge= person.judgement
                    if person.confidence
                      .report-meta= person.confidence.charAt(0).toUpperCase() + person.confidence.slice(1) + ' confidence'
                  td.report-reason
                    p= person.summary
                    if person.documentNote
                      p.report-meta= person.documentNote
                    if person.checklist && person.checklist.length
                      details.report-criteria
                        summary Requirement by requirement
                        table
                          thead
                            tr
                              th Category
                              th Requirement
                              th Result
                              th Evidence
                          tbody
                            each item in person.checklist
                              tr
                                td= item.group
                                td= item.criterion
                                td= resultLabels[item.result] || item.result
                                td= item.evidence

      p.report-back
        a.btn.btn-ghost(href=`/jobs/${job.id}/applications`)
          i.fas.fa-arrow-left
          |  Back to applications
