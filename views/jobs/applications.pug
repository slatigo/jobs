extends ../layout

block content
  section.page-header
    .container
      p.breadcrumb
        a(href="/jobs") Jobs
        span.sep /
        a(href=`/jobs/${job.id}`)= job.title
        span.sep /
        span Applications
      h1 Applications
      p #{counts.all} application#{counts.all === 1 ? '' : 's'} for "#{job.title}"

  section.applications-page
    .container

      //- ============================================================
      //- CONTEXT BAR
      //- ============================================================
      .job-context-bar
        .job-context-info
          .company-logo-sm= job.department ? job.department.name.charAt(0).toUpperCase() : 'J'
          div
            strong= job.title
            span= job.department ? job.department.name : '—'
            if job.jobRef
              span.job-ref-inline Ref: #{job.jobRef}
        .job-context-actions
          a.btn.btn-ghost(href=`/jobs/${job.id}`)
            i.fas.fa-arrow-left
            | Back to Job
          a.btn.btn-ghost(href=`/jobs/${job.id}/stages`)
            i.fas.fa-layer-group
            | Manage Stages

      //- ============================================================
      //- STATUS TABS (built from the job's stages)
      //- ============================================================
      nav.status-tabs
        a.status-tab(
          href=`/jobs/${job.id}/applications`
          class=(activeFilter === 'all' ? 'active' : '')
        )
          i.fas.fa-list
          span All
          span.tab-count= counts.all

        each stage in stages
          a.status-tab(
            href=`/jobs/${job.id}/applications?status=${stage.key}`
            class=(activeFilter === stage.key ? 'active' : '')
          )
            i.fas.fa-circle
            span= stage.label
            span.tab-count= counts[stage.key] || 0

      //- ============================================================
      //- BULK BAR
      //- ============================================================
      if counts.all > 0
        .bulk-bar
          .bulk-left
            input(type="checkbox" id="selectAll")
            label(for="selectAll") Select all
            span#selectedCount.selected-count No rows selected

          .bulk-right
            //- Quick "reject everything in this tab"
            if activeFilter !== 'all' && activeFilter !== 'rejected' && counts[activeFilter] > 0
              - const activeStageDef = stages.find(s => s.key === activeFilter)
              button.btn.btn-sm.btn-ghost(
                type="button"
                onclick=`bulkMove('${activeFilter}', ${counts[activeFilter]}, 'rejected', 'Rejected')`
              )
                i.fas.fa-ban
                | Reject All #{activeStageDef ? activeStageDef.label : activeFilter}

            //- Stage picker for the current selection
            .bulk-stage-picker
              select#bulkStageSelect.stage-select
                option(value="") Move selected to…
                each stage in stages
                  option(value=stage.key)= stage.label

              button.btn.btn-sm.btn-primary(
                type="button"
                id="bulkMoveSelected"
                onclick="bulkMoveSelected()"
              )
                i.fas.fa-arrow-right
                | Apply

      //- ============================================================
      //- APPLICATIONS TABLE
      //- ============================================================
      if applications && applications.length
        .app-table-wrap
          table.app-table
            thead
              tr
                th.th-check
                th Applicant
                th.th-hide-sm Contact
                th.th-hide-md Applied
                th Status
                th.th-hide-md CV
                th.th-actions Actions

            tbody
              each a in applications
                - const stageDef   = stages.find(s => s.key === a.status)
                - const stageColor = stageDef ? stageDef.color : 'muted'
                - const stageLabel = stageDef ? stageDef.label : a.status

                //- ============================================================
                //- MAIN ROW
                //- ============================================================
                tr.app-row(
                  class=`status-${a.status}`
                  data-app-id=a.id
                  data-app-name=a.fullName
                  data-app-email=a.email
                  data-app-status=a.status
                  data-details-id=`details-${a.id}`
                )
                  td.td-check
                    input.app-checkbox(type="checkbox" value=a.id)

                  td.td-applicant
                    .applicant-cell
                      .applicant-avatar-sm= a.fullName.charAt(0).toUpperCase()
                      div
                        strong= a.fullName
                        if a.coverLetter
                          span.cover-preview= a.coverLetter.slice(0, 60) + (a.coverLetter.length > 60 ? '…' : '')

                  td.td-contact.th-hide-sm
                    a(href=`mailto:${a.email}`)= a.email
                    if a.phone
                      br
                      a(href=`tel:${a.phone}`)= a.phone

                  td.th-hide-md
                    = appTime.formatDate(a.createdAt)

                  td
                    button.pill.pill-btn(
                      type="button"
                      class=`pill-${stageColor}`
                      data-stage-menu=a.id
                      aria-haspopup="true"
                      aria-expanded="false"
                      title="Change stage"
                    )
                      = stageLabel
                      i.fas.fa-chevron-down.pill-caret

                  td.th-hide-md
                    if a.attachmentUrl
                      a.btn.btn-sm.btn-ghost(
                        href=`/files/resumes/${a.attachmentUrl.split('/').pop()}`
                        target="_blank"
                        rel="noopener"
                        title=a.attachmentName
                      )
                        i.fas.fa-file-pdf
                    else
                      span.text-muted —

                  td.td-actions
                    .quick-actions
                      //- The expand drawer toggle stays — it's unrelated to stage changes
                      button.icon-btn.icon-btn-toggle(
                        type="button"
                        title="Show details"
                        data-expand-row=a.id
                      )
                        i.fas.fa-chevron-down

                //- ============================================================
                //- DETAIL DRAWER
                //- ============================================================
                tr.app-detail-row(id=`details-${a.id}`)
                  td(colspan="7")
                    .detail-drawer

                      if a.coverLetter
                        .detail-col
                          .detail-label
                            i.fas.fa-comment-alt
                            | Cover Letter
                          .detail-body= a.coverLetter

                      if a.history && a.history.length
                        .detail-col
                          .detail-label
                            i.fas.fa-history
                            | History
                          ul.history-list
                            each h in a.history
                              - const toStageDef   = stages.find(s => s.key === h.toStatus)
                              - const fromStageDef = stages.find(s => s.key === h.fromStatus)

                              li.history-item
                                .history-line
                                  span.status-from
                                    = fromStageDef ? fromStageDef.label : (h.fromStatus || '—')
                                  i.fas.fa-arrow-right
                                  span.status-to(class=`status-${toStageDef ? toStageDef.color : 'muted'}`)
                                    = toStageDef ? toStageDef.label : h.toStatus

                                .history-meta
                                  span
                                    i.fas.fa-user
                                    = h.changedBy ? h.changedBy.name : 'System'
                                  span
                                    i.fas.fa-clock
                                    = appTime.format(h.createdAt)
                                  if h.source && h.source !== 'single'
                                    span.history-source
                                      i.fas.fa-layer-group
                                      = h.source

                                if h.reason
                                  .history-reason= h.reason

        //- ==============================================================
        //- PORTALLED STAGE MENUS
        //- Rendered OUTSIDE the table so they escape the .app-table-wrap
        //- clipping / stacking context. JS positions them via getBoundingClientRect.
        //- ==============================================================
        each a in applications
          .stage-menu-portal(
            id=`stage-menu-${a.id}`
            role="menu"
            hidden
          )
            each target in stages
              if target.key === a.status
                button.stage-menu-item.is-current(
                  type="button"
                  disabled
                )
                  span.stage-dot(class=`dot-${target.color}`)
                  span.stage-menu-label= target.label
                  i.fas.fa-check
              else
                button.stage-menu-item(
                  type="button"
                  role="menuitem"
                  data-app-id=a.id
                  data-target-key=target.key
                  data-target-label=target.label
                  data-app-name=a.fullName
                )
                  span.stage-dot(class=`dot-${target.color}`)
                  span.stage-menu-label= target.label

      else
        .empty-state
          i.fas.fa-inbox
          if activeFilter === 'all'
            h3 No applications yet
            p This job hasn't received any applications.
          else
            - const emptyStageDef = stages.find(s => s.key === activeFilter)
            h3 No #{emptyStageDef ? emptyStageDef.label : activeFilter} applications
            p No applications with this status.
            a.btn.btn-primary(href=`/jobs/${job.id}/applications`) View All Applications

block scripts
  script(src="/js/applications.js" defer)