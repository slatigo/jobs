extends ../layout

block content
  section.auth-section
    .auth-container.auth-container--narrow
      .auth-form-wrapper
        form.auth-form(action="/auth/change-password" method="POST" novalidate)
          h1 Change Password
          p.auth-subtitle Update the password for your MUBS Job Portal account.

          .form-group
            label(for="currentPassword") Current password
            input#currentPassword.form-control(
              type="password"
              name="currentPassword"
              required
              autofocus
            )

          .form-group
            label(for="password") New password
            input#password.form-control(
              type="password"
              name="password"
              minlength="6"
              placeholder="At least 6 characters"
              required
            )

          .form-group
            label(for="passwordConfirm") Confirm new password
            input#passwordConfirm.form-control(
              type="password"
              name="passwordConfirm"
              minlength="6"
              required
            )

          button.btn.btn-primary.btn-block(type="submit") Update password

          .auth-footer
            p
              a(href="/") Back to home