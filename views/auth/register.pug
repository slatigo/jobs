extends ../layout

block content
  section.auth-section
    .auth-container
      .auth-visual
        .auth-visual-content
          h2 Join MUBS Job Portal
          p Create your free account to browse and apply for academic, administrative, and support staff vacancies at Makerere University Business School.
          .auth-features
            .auth-feature
              i.fas.fa-user-graduate
              span For students, alumni & professionals
            .auth-feature
              i.fas.fa-briefcase
              span Apply for open positions
            .auth-feature
              i.fas.fa-shield-alt
              span Secure & confidential

      .auth-form-wrapper
        .auth-form
          h1 Create Account
          p.auth-subtitle Register to start applying for positions

          form(action="/auth/register" method="POST" novalidate)
            input(type="hidden" name="returnTo" value=returnTo || '/')

            .form-group
              label Full Name *
              input(
                type="text"
                name="name"
                required
                minlength="3"
                maxlength="120"
                autocomplete="name"
                placeholder="e.g. Jane Nakato"
                value=formName && formName[0] ? formName[0] : ''
              )

            .form-group
              label Email *
              input(
                type="email"
                name="email"
                required
                maxlength="160"
                autocomplete="email"
                placeholder="you@mubs.ac.ug"
                value=formEmail && formEmail[0] ? formEmail[0] : ''
              )

            .form-group
              label Course / Programme
              input(
                type="text"
                name="course"
                maxlength="120"
                placeholder="e.g. BBA, BCOM, BSc CS"
                value=formCourse && formCourse[0] ? formCourse[0] : ''
              )

            .form-group
              label Phone
              input(
                type="tel"
                name="phone"
                maxlength="30"
                autocomplete="tel"
                placeholder="+256 7XX XXX XXX"
                value=formPhone && formPhone[0] ? formPhone[0] : ''
              )

            .form-group
              label Password *
              input(
                type="password"
                name="password"
                required
                minlength="6"
                autocomplete="new-password"
                placeholder="At least 6 characters"
              )

            .form-group
              label Confirm Password *
              input(
                type="password"
                name="passwordConfirm"
                required
                minlength="6"
                autocomplete="new-password"
                placeholder="Re-enter your password"
              )

            button.btn.btn-primary.btn-block(type="submit")
              i.fas.fa-user-plus
              |  Create Account

          p.auth-footer
            | Already have an account? 
            a(href="/auth/login") Login

block scripts
  script.
    (function () {
      const form = document.querySelector('form[action="/auth/register"]');
      form.addEventListener('submit', function (e) {
        const pw  = form.querySelector('input[name="password"]').value;
        const pw2 = form.querySelector('input[name="passwordConfirm"]').value;
        if (pw !== pw2) {
          e.preventDefault();
          alert('Passwords do not match.');
        }
      });
    })();