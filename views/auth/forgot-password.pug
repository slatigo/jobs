extends ../layout

block content
  section.auth-section
    .auth-container
      .auth-visual
        .auth-visual-content
          h2 Forgot Your Password?
          p Enter your email address and we'll send you a link to reset it.
          .auth-features
            .auth-feature
              i.fas.fa-envelope
              span Check your inbox
            .auth-feature
              i.fas.fa-clock
              span Link valid for 1 hour
            .auth-feature
              i.fas.fa-shield-alt
              span Your account stays secure

      .auth-form-wrapper
        .auth-form
          h1 Reset Password
          p.auth-subtitle We'll email you a secure reset link

          form(action="/auth/forgot-password" method="POST")
            .form-group
              label Email Address
              input(
                type="email"
                name="email"
                required
                autofocus
                placeholder="you@mubs.ac.ug"
              )

            button.btn.btn-primary.btn-block(type="submit")
              i.fas.fa-paper-plane
              |  Send Reset Link

          p.auth-footer
            | Remembered it? 
            a(href="/auth/login") Back to login