extends ../layout

block content
  section.auth-section
    .auth-container
      .auth-visual
        .auth-visual-content
          h2 Set a New Password
          p Choose a strong password you haven't used before.
          .auth-features
            .auth-feature
              i.fas.fa-lock
              span At least 6 characters
            .auth-feature
              i.fas.fa-shield-alt
              span Stored securely (bcrypt)
            .auth-feature
              i.fas.fa-check-circle
              span Ready to log in

      .auth-form-wrapper
        .auth-form
          h1 New Password
          p.auth-subtitle Enter and confirm your new password

          form(action=`/auth/reset-password/${token}` method="POST")
            .form-group
              label New Password *
              input(
                type="password"
                name="password"
                required
                minlength="6"
                autofocus
                placeholder="At least 6 characters"
              )

            .form-group
              label Confirm New Password *
              input(
                type="password"
                name="passwordConfirm"
                required
                minlength="6"
                placeholder="Re-enter your password"
              )

            button.btn.btn-primary.btn-block(type="submit")
              i.fas.fa-check
              |  Reset Password

          p.auth-footer
            | Changed your mind? 
            a(href="/auth/login") Back to login