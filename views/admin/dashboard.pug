extends ../layout

block content
  section.page-header
    .container
      p.breadcrumb
        a(href="/") Home
        span.sep /
        span Admin
      h1 Admin Dashboard
      p Overview of users, vacancies, departments, and applications

  section.admin-section
    .container

      //- ============================================================
      //- STATS
      //- ============================================================
      .admin-stats
        .stat-card
          i.fas.fa-users
          h3= stats.users
          p Users

        .stat-card
          i.fas.fa-briefcase
          h3= stats.jobs
          p Total Jobs

        .stat-card
          i.fas.fa-check-circle
          h3= stats.activeJobs
          p Active Jobs

        .stat-card
          i.fas.fa-lock
          h3= stats.closedJobs
          p Closed Jobs

        .stat-card
          i.fas.fa-file-alt
          h3= stats.applications
          p Applications

        .stat-card
          i.fas.fa-university
          h3= stats.departments
          p Departments

      //- ============================================================
      //- QUICK ACTIONS
      //- ============================================================
      .admin-actions
        a.btn.btn-primary(href="/admin/users")
          i.fas.fa-users
          |  Manage Users
        a.btn.btn-primary(href="/jobs")
          i.fas.fa-briefcase
          |  Manage Jobs
        a.btn.btn-primary(href="/admin/departments")
          i.fas.fa-university
          |  Departments
        
        a.btn.btn-outline(href="/jobs/new")
          i.fas.fa-plus
          |  Post a Job

      //- ============================================================
      //- RECENT JOBS
      //- ============================================================
      if recentJobs && recentJobs.length
        .admin-panel
          .admin-panel-head
            h2 Recent Jobs
            a.view-all(href="/jobs") View all →

          table.admin-table
            thead
              tr
                th Job
                th Department
                th Status
                th Posted

            tbody
              each job in recentJobs
                tr
                  td
                    a(href=`/jobs/${job.id}`)= job.title
                    if job.jobRef
                      br
                      small.text-muted-inline Ref: #{job.jobRef}
                  td= job.department ? job.department.name : '—'
                  td
                    if job.status === 'active'
                      span.pill.pill-success Active
                    else
                      span.pill.pill-muted Closed
                  td
                    - const postedAt = new Date(job.createdAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })
                    = postedAt

      
      //- ============================================================
      //- EMPTY STATE
      //- ============================================================
      if (!recentJobs || !recentJobs.length) && (!recentApplications || !recentApplications.length)
        .empty-state
          i.fas.fa-inbox
          h3 Nothing to show yet
          p Once you post jobs and receive applications, they'll appear here.
          .admin-actions(style="justify-content:center;margin-top:16px")
            a.btn.btn-primary(href="/jobs/new")
              i.fas.fa-plus
              |  Post the First Job